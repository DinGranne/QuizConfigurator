<UserControl x:Class="QuizConfigurator.Views.ConfigurationView"             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             DataContext="{Binding ConfigurationViewModel}"
             xmlns:local="clr-namespace:QuizConfigurator.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" /> 
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
               Text="{Binding ActivePack.Name}"
               FontSize="28"
               Margin="0,0,0,15" />

        <ListBox Grid.Row="1"
         ItemsSource="{Binding ActivePack.Questions}"
         SelectedItem="{Binding SelectedQuestion, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Query}"
                           FontSize="18"
                           Margin="5"
                           TextWrapping="Wrap" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="2"
           Text="{Binding SelectedQuestion.Query}"
           FontSize="20"
           Margin="0,15,0,0"
           TextWrapping="Wrap" />
    </Grid>
</UserControl>
