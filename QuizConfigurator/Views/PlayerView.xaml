<UserControl x:Class="QuizConfigurator.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding PlayerViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <TextBlock Text="Spela quiz"
                       FontSize="28"
                       Margin="0,0,0,15" />

            <Button Content="Starta quiz"
                    Command="{Binding StartQuizCommand}"
                    HorizontalAlignment="Left"
                    Padding="15,8"
                    Margin="0,0,0,20" />

            <TextBlock Text="{Binding Message}"
                       FontSize="16"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10" />

            <TextBlock Text="{Binding ProgressText}"
                       FontSize="18"
                       Margin="0,0,0,10" />

            <TextBlock Text="{Binding CurrentQuestion.Query}"
                       FontSize="24"
                       TextWrapping="Wrap" />

        </StackPanel>
    </ScrollViewer>
</UserControl>