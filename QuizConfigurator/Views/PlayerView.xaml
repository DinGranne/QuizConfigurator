<UserControl x:Class="QuizConfigurator.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding PlayerViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <TextBlock Text="Spela quiz"
                       FontSize="28"
                       Margin="0,0,0,15" />

            <Button Content="Starta quiz"
                    Command="{Binding StartQuizCommand}"
                    HorizontalAlignment="Left"
                    Padding="15,8"
                    Margin="0,0,0,20" />

            <TextBlock Text="{Binding Message}"
                       FontSize="16"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10" />

            <TextBlock Text="{Binding ProgressText}"
                       FontSize="18"
                       Margin="0,0,0,10" />

            <TextBlock Text="{Binding CurrentQuestion.Query}"
                       FontSize="24"
                       TextWrapping="Wrap"
                       Margin="0,0,0,20" />

            <ItemsControl ItemsSource="{Binding Answers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.AnswerCommand,
                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                HorizontalContentAlignment="Left"
                                Padding="12,8"
                                Margin="0,0,0,8">

                            <TextBlock Text="{Binding Text}"
                                       FontSize="18"
                                       TextWrapping="Wrap" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding Feedback}"
                       FontSize="18"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       Margin="0,15,0,0" />

        </StackPanel>
    </ScrollViewer>
</UserControl>