<Window x:Class="QuizConfigurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:QuizConfigurator.Views"
        Title="Quiz Configurator"
        Height="550"
        Width="900">

    <Window.InputBindings>
        <KeyBinding Key="N"
                    Modifiers="Control"
                    Command="{Binding ConfigurationViewModel.AddQuestionCommand}" />

        <KeyBinding Key="D"
                    Modifiers="Control"
                    Command="{Binding ConfigurationViewModel.RemoveQuestionCommand}" />

        <KeyBinding Key="O"
                    Modifiers="Control"
                    Command="{Binding ConfigurationViewModel.OpenPackOptionsCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <views:MenuView Grid.Row="0" />

        <StackPanel Grid.Row="1"
                    Margin="20,15,20,0">

            <TextBlock Text="Välj frågepaket"
                       Margin="0,0,0,5" />

            <ComboBox ItemsSource="{Binding Packs}"
                      SelectedItem="{Binding ActivePack, Mode=TwoWay}"
                      DisplayMemberPath="Name"
                      MinWidth="250"
                      HorizontalAlignment="Left" />
        </StackPanel>

        <views:ConfigurationView Grid.Row="2" />
    </Grid>
</Window>