<Window x:Class="QuizConfigurator.Dialogs.PackOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuizConfigurator.Dialogs"
        mc:Ignorable="d"
        Title="Paketinställningar"
Height="350"
Width="400"
ResizeMode="NoResize"
WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="3.406" />
            <RowDefinition Height="46"/>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
               Text="Paketinställningar"
               FontSize="24"
               Margin="0,0,0,15" Grid.RowSpan="2" />

        <StackPanel Grid.Row="1" Margin="0,41,0,0" Grid.RowSpan="2">
            <TextBlock Text="Paketets namn" />
            <TextBox Text="{Binding Name,
                       Mode=TwoWay,
                       UpdateSourceTrigger=PropertyChanged}"
         Margin="0,5,0,0" />

            <TextBlock Text="Svårighetsgrad" />
            <ComboBox ItemsSource="{Binding Difficulties}"
          SelectedItem="{Binding Difficulty, Mode=TwoWay}"
          Margin="0,5,0,12" />

            <TextBlock Text="Tid per fråga (sekunder)" />
            <TextBox Text="{Binding TimeLimitText,
                       Mode=TwoWay,
                       UpdateSourceTrigger=PropertyChanged}"
         Margin="0,5,0,0" />

        </StackPanel>

        <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,20,0,0" Width="190">

            <Button Content="Spara"
        Command="{Binding SaveCommand}"
        Width="90"
        Padding="8,5"
        Margin="0,0,10,0" />

            <Button Content="Avbryt"
        IsCancel="True"
        Width="90"
        Padding="8,5" />
        </StackPanel>
    </Grid>

</Window>
